# NVIDIA ARM64 Platform-Specific Device Drivers
#

config MTK_PCIE_HOTPLUG
	tristate "MediaTek PCIe Hotplug Driver"
	depends on (ARCH_MEDIATEK || COMPILE_TEST) && PCI
	depends on ACPI || OF
	depends on GPIOLIB
	default m if ARCH_MEDIATEK
	help
	  Say Y here to enable the MediaTek PCIe hotplug driver for
	  managing PCIe device hot-plug events on MediaTek SoCs.
	  
	  This driver handles GPIO-based detection of PCIe device
	  insertion/removal and coordinates with the PCIe subsystem
	  to properly initialize or remove devices.
	  
	  GPIOs are enumerated from ACPI _CRS using direct resource
	  parsing to work around kernel 6.17+ GPIO grouping regression.
	  
	  MMIO resources are preferred from ACPI _CRS, but the driver
	  can fall back to platform device resources (provided by
	  mtk-pcie-mmio-resources module) until firmware team adds MMIO
	  to PEDE device in DSDT.
	  
	  This is particularly useful for MediaTek MT8901 SoC-based
	  systems like NVIDIA DGX Spark.
	  
	  If unsure, say N.

